{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/libros/comentario-doctrinal-nuevo-testamento-tomo-1/",
      "destination": "/libros/comentario-doctrinal-del-nuevo-testamento-tomo-1/",
      "statusCode": 301
    },
    {
      "source": "/libros/comentario-doctrinal-nuevo-testamento-tomo-1",
      "destination": "/libros/comentario-doctrinal-del-nuevo-testamento-tomo-1/",
      "statusCode": 301
    },
    {
      "source": "/libros/comentario-doctrinal-del-nuevo-testamento/",
      "destination": "/libros/comentario-doctrinal-del-nuevo-testamento-tomo-2/",
      "statusCode": 301
    },
    {
      "source": "/libros/comentario-doctrinal-del-nuevo-testamento",
      "destination": "/libros/comentario-doctrinal-del-nuevo-testamento-tomo-2/",
      "statusCode": 301
    },
    {
      "source": "/pt/livros/comentario-doutrinal-do-novo-testamento/",
      "destination": "/pt/livros/comentario-doutrinal-do-novo-testamento-tomo-2/",
      "statusCode": 301
    },
    {
      "source": "/pt/livros/comentario-doutrinal-do-novo-testamento",
      "destination": "/pt/livros/comentario-doutrinal-do-novo-testamento-tomo-2/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
